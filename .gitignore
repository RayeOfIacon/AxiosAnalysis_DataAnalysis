# Keep source code and documentation only.
*.csv
*.tsv
*.json
*.jsonl
*.parquet
*.feather
*.arrow
*.xlsx
*.xls

# Exclude generated figures and exported documents.
*.png
*.jpg
*.jpeg
*.svg
*.pdf
figures/
plots/
outputs/

# Exclude Python environments, caches, and build artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Exclude local settings and common credential files.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# Exclude editor and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
